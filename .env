# Production Environment Variables
# These variables configure the frontend to use production backend API

# Backend API URL (Production)
VITE_API_URL=https://api.threadsaints.com

# Application Environment
VITE_NODE_ENV=production

# PhonePe Merchant ID (Production)
VITE_PHONEPE_MERCHANT_ID=SU2512062001254360588250

# ============================================
# DEVELOPMENT FALLBACK (for local testing)
# ============================================
# Uncomment these for local development:
# VITE_API_URL=http://localhost:5000
# VITE_NODE_ENV=development
# VITE_PHONEPE_MERCHANT_ID=PGTESTPAYUAT86
